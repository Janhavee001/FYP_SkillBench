# ---------------------------------------------------------------------------
# benchmark-fyp — environment template
# Copy to .env at the project root and fill in real values. .env is gitignored.
#   cp .env.example .env
# Every runner reads these via harness/common.py; no key is ever hard-coded in
# a repo config file.
# ---------------------------------------------------------------------------

# --- Which provider serves the model under test ----------------------------
#   openrouter  -> OPENROUTER_API_KEY against openrouter.ai/api/v1
#                  (used for all SkillBench and StatABench results in the report)
#   huggingface -> HF_TOKEN against router.huggingface.co/v1
#                  (a drop-in OpenAI-compatible endpoint; used in phase 1)
#   openai      -> OPENAI_API_KEY against api.openai.com
LLM_PROVIDER=openrouter

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ------------------------
OPENROUTER_API_KEY=your-openrouter-key-here

# --- Hugging Face (used when LLM_PROVIDER=huggingface) ---------------------
# IMPORTANT: a plain read token is NOT enough for inference. Create a
# fine-grained token with "Make calls to Inference Providers" enabled at
#   https://huggingface.co/settings/tokens
# The same token is also used to download DataSciBench's gated ground truth,
# which additionally requires accepting the gate at
#   https://huggingface.co/datasets/zd21/DataSciBench
HF_TOKEN=your-huggingface-key-here

# --- OpenAI (used when LLM_PROVIDER=openai) --------------------------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model under test ------------------------------------------------------
# All five systems must use the SAME model or the comparison means nothing.
# HF ids may carry a routing suffix: ":fastest" (default), ":cheapest", or a
# specific provider such as ":groq".
#   huggingface examples: openai/gpt-oss-120b, openai/gpt-oss-120b:cheapest,
#                         Qwen/Qwen2.5-72B-Instruct, deepseek-ai/DeepSeek-V3
#   openai examples:      gpt-4o-mini, gpt-4o
BENCH_MODEL=openai/gpt-oss-120b

# Judge model for the rubric's interpretation dimension. Keep it FIXED across
# all systems so the scores stay comparable. Defaults to BENCH_MODEL.
JUDGE_MODEL=openai/gpt-oss-120b

# --- Harness behaviour -----------------------------------------------------
BENCH_TEMPERATURE=0
BENCH_SEED=42
# Runners take --limit on the command line; start small to check credit burn:
#   ... run_baseline.py --mode plain --limit 4

# --- Optional: only if you swap a repo onto another provider ---------------
# harness/setup_keys.py generates repos/StatABench/keys.json from the settings
# above, so these are not normally needed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# nvAgent was written against Azure OpenAI; harness/runners/run_nvagent.py
# monkeypatches it onto the provider selected above, so these are only for
# running it on Azure as the authors did.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# nvAgent's native VisEval scoring renders charts in headless Chrome. Not
# needed for the shared-dataset run in this harness.
CHROMEDRIVER_PATH=
